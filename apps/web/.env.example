# Web（Next.js）公開用テンプレート。値は空 or ダミー。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Render Free のログイン起こし。有料常時起動にしたら 0（docs/deploy/README.md）
# NEXT_PUBLIC_API_WAKE_ON_AUTH=0
# 任意（リダイレクト組み立て用）
# NEXT_PUBLIC_BASE_URL=https://oshihaven.com

# Turnstile Site Key（公開可）。Secret は Supabase Auth CAPTCHA のみ。Git に実値を書くな
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# サーバーのみ（NEXT_PUBLIC にしない）。本番では無効。
# Supabase 未設定でも保護ルートを通すローカル骨格用。通常は設定しない。
# AUTH_GATE_BYPASS=1

# Render無料プランのコールドスタート対策（ログインで起動＝1起動しない=0）
NEXT_PUBLIC_API_WAKE_ON_AUTH=1

# 登録 E2E 専用（本番・Cloudflare には置かない）
# NEXT_PUBLIC_E2E_AUTH_STUB_ENABLED=1
# E2E_AUTH_STUB_ENABLED=1
