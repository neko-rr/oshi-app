# API ローカル用（apps/api/.env）。値は空。Git に実値を入れない。
# コピー元: このファイル → apps/api/.env

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 未設定時は SUPABASE_URL + /auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# ※ SUPABASE_JWT_SECRET（Legacy HS256）は検証に使わない。設定しても無視される。

# 任意: docs 生成スクリプト用（アプリ実行には不要。Git に実値を入れない）
# DATABASE_URL=
# または SUPABASE_DB_URL=

# CORS（未設定時のデフォルト: localhost:3000 系）
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 製品一覧 / 登録には SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY が必要
# JWT 検証には Signing Keys 有効化後の JWKS（keys が空でないこと）が必要

# --- 外部アシスト（既定は実 HTTP オフ。本保存はアシスト非依存） ---
# IO_INTELLIGENCE_API_KEY=
# IO_INTELLIGENCE_API_URL=https://api.intelligence.io.solutions/api/v1/chat/completions
# IO_INTELLIGENCE_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
# IO_TAG_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
# IO_INTELLIGENCE_FALLBACK_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# IO_LIVE_CALLS=0

# 楽天 2026 新API（再登録済み想定）。公式: docs/refs/official-links.md
# applicationId=UUID / accessKey / 許可Webサイトと一致する ORIGIN
# RAKUTEN_APPLICATION_ID=
# RAKUTEN_ACCESS_KEY=
# RAKUTEN_AFFILIATE_ID=
# RAKUTEN_ORIGIN=https://oshi-app-1.onrender.com
# RAKUTEN_LIVE_CALLS=0

# 推し色の保存・全体適用（課金前は未設定＝ロック。開発確認のみ 1）
# OSHI_ACCENT_ENTITLED=0
