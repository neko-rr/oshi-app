# monorepo ルートの例。実値は載せない。
# Web は apps/web/.env.local、API は apps/api/.env を使用。

# --- Web (NEXT_PUBLIC_*) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- API ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_SECRET=
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- IO Intelligence（https://io.net/docs/guides/intelligence/api-keys-and-secrets）---
# IO Intelligence → API Keys and Secrets で発行（IO ID の別トークンではない）
# IO_INTELLIGENCE_API_KEY=
# IO_INTELLIGENCE_MODEL=meta-llama/Llama-3.2-90B-Vision-Instruct
# IO_INTELLIGENCE_FALLBACK_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# IO_TAG_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
# IO_LIVE_CALLS=0

# --- 楽天（実値は apps/api/.env のみ。ルートには置かない）---
# RAKUTEN_APPLICATION_ID=
# RAKUTEN_ACCESS_KEY=
# RAKUTEN_AFFILIATE_ID=
# RAKUTEN_ORIGIN=https://oshi-app-1.onrender.com
# RAKUTEN_LIVE_CALLS=0
